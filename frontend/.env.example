# Server-only FastAPI origin. Do not prefix this with NEXT_PUBLIC_.
# In production ANI4U_BACKEND_URL takes precedence, so it can point the Vercel
# frontend at an independently hosted FastAPI service.
ANI4U_BACKEND_URL=
API_BASE_URL=http://127.0.0.1:8000
API_TIMEOUT_MS=120000
# Set your real public origin before deployment (canonical/OG metadata).
SITE_URL=http://localhost:3000
